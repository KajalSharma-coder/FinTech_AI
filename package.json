{
  "name": "ieee-hacks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "server": "node --env-file-if-exists=.env backend/server.mjs",
    "db:init": "node --env-file-if-exists=.env backend/init-db.mjs",
    "db:migrate:sqlite": "node --env-file-if-exists=.env backend/migrate-sqlite.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/riskEngine.test.ts tests/ingestion.test.ts tests/indicatorExtraction.test.ts tests/relatedAds.test.ts tests/evidence.test.ts tests/alerts.test.ts tests/integration.test.ts tests/analysisSummary.test.ts tests/textVerification.test.ts tests/ocr.test.ts tests/backend.test.ts",
    "test:risk": "node --experimental-strip-types --test tests/riskEngine.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "pg": "^8.16.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
